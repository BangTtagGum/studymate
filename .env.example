# 스터디 기록 저장소 (멤버들이 collaborator 로 참여하는 저장소)
GITHUB_OWNER=your-github-id
GITHUB_REPO=study-log
GITHUB_BRANCH=main
# 저장소에 Contents·Issues 쓰기 권한이 있는 Personal Access Token
# (classic 이면 repo, fine-grained 면 Contents: Read and write + Issues: Read and write)
GITHUB_TOKEN=ghp_xxx
# GitHub 웹훅 설정의 Secret 과 동일하게 (비우면 서명 검증 생략 — 로컬 전용)
GITHUB_WEBHOOK_SECRET=

# 없으면 더미 질문·리뷰로 파이프라인만 동작
ANTHROPIC_API_KEY=

# 호스팅 플랫폼이 주입하는 포트. 로컬은 비워두면 8080
# PORT=8080
